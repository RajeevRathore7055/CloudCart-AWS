# Copy this file to .env and fill real values. NEVER commit .env
DATABASE_HOST=localhost            # on AWS: your RDS endpoint
DATABASE_PORT=3306
DATABASE_NAME=cloudcart
DATABASE_USER=cloudcart_user       # on AWS RDS: admin
DATABASE_PASSWORD=change_me
SECRET_KEY=change_me_to_a_long_random_string   # must be IDENTICAL on every server of the same site

# Admin account created by `python -m scripts.init_db`.
# Local demo: you may keep the demo value. On AWS use a STRONG password.
# If ADMIN_PASSWORD is empty, init_db generates a random one and prints it once.
ADMIN_EMAIL=admin@cloudcart.com
ADMIN_PASSWORD=Admin@123

# Set true only when the site is served over HTTPS (CloudFront / ALB with certificate)
COOKIE_SECURE=false

# AWS (leave empty for a local run)
AWS_REGION=
S3_BUCKET_NAME=
# Optional: CloudFront domain for images, e.g. https://d1234abcd.cloudfront.net
IMAGE_BASE_URL=
